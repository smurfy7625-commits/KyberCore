# Kyber Core public configuration example.
# Copy this file to .env and edit for your OMV host.

CONTAINER_NAME=kyber-core
KYBER_PORT=8088
TZ=UTC
PUID=1000
PGID=100

# Host path containing Docker Compose projects Kyber Core may manage.
HOST_COMPOSE_ROOT=/opt/compose

# Host storage root visible to Kyber Core.
HOST_STORAGE_ROOT=/srv

# Optional local Ollama-compatible AI endpoint.
OLLAMA_URL=
OLLAMA_MODEL=qwen3:4b

# Authentication
# Session lifetime in seconds. 43200 = 12 hours.
AUTH_SESSION_SECONDS=43200

# Keep false for local HTTP. Set true only when accessed through HTTPS.
AUTH_COOKIE_SECURE=false
